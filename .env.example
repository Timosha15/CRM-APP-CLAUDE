DATABASE_URL="postgresql://user:password@host:5432/database"
JWT_SECRET="replace-with-a-long-random-secret"

# Email (Resend) — optional. Without this, sending emails and task
# reminder digests will return a clear error instead of working.
RESEND_API_KEY="re_your_api_key"
EMAIL_FROM="Victor <onboarding@resend.dev>"

# Used to build links inside emails (e.g. "Open Victor" button).
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>`
# when it calls /api/cron/task-reminders. Any random string.
CRON_SECRET="replace-with-a-long-random-secret"
